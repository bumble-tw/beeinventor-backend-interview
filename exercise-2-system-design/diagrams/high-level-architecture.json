    "views": [
      {
        "id": "search",
        "label": "Search",
        "focus": [
          "browser",
          "alb",
          "api",
          "redis",
          "opensearch",
          "aurora"
        ],
        "note": "Keywords and a permission filter in OpenSearch, then a permission re-check in PostgreSQL."
      },
      {
        "id": "upload",
        "label": "Upload",
        "focus": [
          "browser",
          "alb",
          "api",
          "aurora",
          "s3",
          "sqs"
        ],
        "note": "The API creates the document record and signs an upload link; the file goes straight to S3, which queues a job."
      },
      {
        "id": "background",
        "label": "Background processing",
        "focus": [
          "sqs",
          "workers",
          "s3",
          "opensearch",
          "aurora"
        ],
        "note": "Workers build the passage index and mark the document searchable."
      },
      {
        "id": "delete",
        "label": "Delete",
        "focus": [
          "api",
          "aurora",
          "sqs",
          "workers",
          "opensearch",
          "cron",
          "s3"
        ],
        "note": "Hidden at once; a delete job removes the passages; after 30 days a CronJob deletes every S3 version and the metadata."
      }
    ],
